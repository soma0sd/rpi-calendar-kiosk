[Unit]
Description=rpi-calendar-kiosk (PC monitor and calendar kiosk)
After=graphical-session.target
PartOf=graphical-session.target
# OOM 등 비정상 종료 시 무한 재시작 루프 방지.
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/Project/soma0sd_RPi_Schedule
# Wayland 환경 변수는 graphical-session 환경에서 import 되지만 일부 케이스에서는
# 비어 있으므로 ExecStart 자체가 다시 채운다.
# --host 0.0.0.0 은 Windows PC 의 지표 푸시를 받기 위한 것이다. 서버가 루프백이 아닌
# 접속에는 POST /api/system 만 허용하므로(rust/src/server.rs::guard_request) 개인 일정이
# 담긴 /api/state 와 UI 는 키오스크 본체에만 노출된다.
ExecStart=/bin/bash -lc 'export XDG_RUNTIME_DIR=/run/user/$(id -u); export WAYLAND_DISPLAY=$(ls "$XDG_RUNTIME_DIR"/wayland-* 2>/dev/null | head -1 | xargs -r basename); /usr/bin/wlr-randr --output HDMI-A-1 --on 2>/dev/null || true; exec "$HOME/.local/bin/rpi-schedule-kiosk" --host 0.0.0.0'
Restart=always
RestartSec=5

[Install]
WantedBy=graphical-session.target
